{
  "name": "loginlens",
  "displayName": "LoginLens",
  "version": "1.0.0",
  "description": "A purely local, zero-server browser extension that observes logins and maps aliases.",
  "author": "LoginLens Team",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "build:edge": "plasmo build --target=edge-mv3",
    "build:opera": "plasmo build --target=opera-mv3",
    "build:brave": "plasmo build --target=brave-mv3",
    "package": "plasmo package",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "config": {},
  "packageManager": "npm@10.8.1",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loginlens/loginlens"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.12.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "next-themes": "^0.3.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "^4.0.1",
    "@types/chrome": "0.0.268",
    "@types/node": "20.14.9",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "storage",
      "tabs",
      "clipboardWrite"
    ]
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.33.4"
    }
  }
}