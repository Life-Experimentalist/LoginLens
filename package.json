{
  "name": "loginlens",
  "displayName": "LoginLens",
  "version": "1.0.0",
  "description": "See which account, OAuth provider, and MFA method you used on every site. Local-first: no passwords stored, no account, no backend, no telemetry.",
  "author": "VKrishna04",
  "license": "Apache-2.0",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-extension",
    "manifest-v3",
    "plasmo",
    "password-manager",
    "credential-manager",
    "oauth",
    "mfa",
    "2fa",
    "privacy",
    "local-first",
    "offline-first",
    "zero-knowledge",
    "security",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation plasmo dev  --target=edge-mv3",
    "build": "cross-env NODE_OPTIONS=--no-deprecation plasmo build",
    "build:chrome": "cross-env NODE_OPTIONS=--no-deprecation plasmo build --target=chrome-mv3",
    "build:firefox": "cross-env NODE_OPTIONS=--no-deprecation plasmo build --target=firefox-mv3",
    "build:firefox-mv2": "cross-env NODE_OPTIONS=--no-deprecation plasmo build --target=firefox-mv2",
    "build:edge": "cross-env NODE_OPTIONS=--no-deprecation plasmo build --target=edge-mv3",
    "build:opera": "cross-env NODE_OPTIONS=--no-deprecation plasmo build --target=opera-mv3",
    "build:brave": "cross-env NODE_OPTIONS=--no-deprecation plasmo build --target=brave-mv3",
    "build:safari": "cross-env NODE_OPTIONS=--no-deprecation plasmo build --target=safari-mv3",
    "package": "cross-env NODE_OPTIONS=--no-deprecation plasmo package",
    "assets": "node scripts/build-ui-assets.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Life-Experimentalist/LoginLens.git"
  },
  "homepage": "https://loginlens.vkrishna04.me",
  "bugs": {
    "url": "https://github.com/Life-Experimentalist/LoginLens/issues"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "lz-string": "^1.5.0",
    "next-themes": "^0.3.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "svgo": "^4.0.2",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "2.9.3",
    "@parcel/transformer-webmanifest": "2.9.3",
    "@plasmohq/prettier-plugin-sort-imports": "^4.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/chrome": "0.0.268",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.19.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "vitest": "^3.2.7"
  },
  "manifest": {
    "permissions": [
      "storage",
      "tabs",
      "clipboardWrite",
      "alarms"
    ]
  },
  "overrides": {
    "@babel/traverse": "^7.23.2",
    "esbuild": "^0.25.0",
    "content-security-policy-parser": "^0.6.0",
    "msgpackr": "^1.10.1",
    "sharp": "^0.35.0"
  }
}
